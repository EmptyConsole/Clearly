{
  "name": "@clearly/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clearly desktop app (Electron).",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.ts",
    "dev": "pnpm --filter @clearly/web build && node scripts/build.ts && electron .",
    "start": "electron .",
    "package": "pnpm --filter @clearly/web build && node scripts/build.ts && electron-builder --config electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "@clearly/core": "workspace:*",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "main": "dist/main.mjs",
  "author": "Clearly",
  "productName": "Clearly"
}
