{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @clearly/web exec vite preview --port 4300 --strictPort",
      "startServerReadyPattern": "4300",
      "url": [
        "http://localhost:4300/",
        "http://localhost:4300/welcome",
        "http://localhost:4300/check",
        "http://localhost:4300/check/before",
        "http://localhost:4300/audio",
        "http://localhost:4300/quiet",
        "http://localhost:4300/quiet/calm",
        "http://localhost:4300/quiet/auto-boost",
        "http://localhost:4300/more",
        "http://localhost:4300/more/health",
        "http://localhost:4300/more/settings",
        "http://localhost:4300/more/privacy"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["accessibility", "best-practices"],
        "preset": "desktop",
        "chromeFlags": "--disable-audio-output"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "test-results/lighthouse" }
  }
}
